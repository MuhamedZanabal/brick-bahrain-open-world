WORLD_LIFECYCLE_TEST_CONTENT = '''extends Node\n\nconst WORLD_FIXTURE = preload("res://tests/world_lifecycle_guard_fixture.gd")\n\nvar passed := 0\nvar failed := 0\n\n\nfunc _ready() -> void:\n\tprocess_mode = Node.PROCESS_MODE_ALWAYS\n\tcall_deferred("_run")\n\n\nfunc _check(condition: bool, label: String) -> void:\n\tif condition:\n\t\tpassed += 1\n\t\tprint("[PASS] " + label)\n\telse:\n\t\tfailed += 1\n\t\tpush_error("[FAIL] " + label)\n\n\nfunc _run() -> void:\n\tvar previous_state = GameManager.current_state\n\tGameManager.current_state = GameManager.GameState.IN_WORLD\n\n\tvar world = WORLD_FIXTURE.new()\n\tworld.name = "LifecycleWorldA"\n\tadd_child(world)\n\tawait get_tree().process_frame\n\tworld._install_world_lifecycle_guard()\n\tvar callback := Callable(world, "_on_world_child_exiting_tree")\n\t_check(world.child_exiting_tree.is_connected(callback), "world lifecycle coordinator connected")\n\t_check(world.child_exiting_tree.get_connections().size() == 1, "repeated lifecycle installation is idempotent")\n\n\tvar player := CharacterBody3D.new()\n\tplayer.name = "LifecyclePlayerA"\n\tworld.player = player\n\tworld.add_child(player)\n\tawait get_tree().process_frame\n\tvar first_position := Vector3(12.5, 2.25, -8.75)\n\tplayer.global_position = first_position\n\t_check(player.is_inside_tree(), "active player transform is valid before exit")\n\n\tvar non_player := Node3D.new()\n\tnon_player.name = "NonPlayerChild"\n\tworld.add_child(non_player)\n\tawait get_tree().process_frame\n\tworld.remove_child(non_player)\n\tawait get_tree().process_frame\n\t_check(world.player == player, "non-player child exit preserves active player reference")\n\n\tworld.remove_child(player)\n\tawait get_tree().process_frame\n\t_check(world.player == null, "active player reference is cleared before world teardown")\n\t_check(SaveManager.get_position().is_equal_approx(first_position), "first valid player position is cached")\n\n\tvar replacement := CharacterBody3D.new()\n\treplacement.name = "LifecyclePlayerB"\n\tworld.player = replacement\n\tworld.add_child(replacement)\n\tawait get_tree().process_frame\n\tvar replacement_position := Vector3(-31.0, 4.5, 19.25)\n\treplacement.global_position = replacement_position\n\tworld.remove_child(replacement)\n\tawait get_tree().process_frame\n\t_check(world.player == null, "replacement player exit clears only the replacement reference")\n\t_check(SaveManager.get_position().is_equal_approx(replacement_position), "replacement position supersedes the earlier cached position")\n\n\tplayer.queue_free()\n\treplacement.queue_free()\n\tnon_player.queue_free()\n\tworld.queue_free()\n\tawait get_tree().process_frame\n\tawait get_tree().process_frame\n\t_check(not is_instance_valid(world), "first world unload completes without a persistent callback")\n\n\tvar world_two = WORLD_FIXTURE.new()\n\tworld_two.name = "LifecycleWorldB"\n\tadd_child(world_two)\n\tawait get_tree().process_frame\n\tworld_two._install_world_lifecycle_guard()\n\tworld_two._install_world_lifecycle_guard()\n\tvar second_player := CharacterBody3D.new()\n\tsecond_player.name = "LifecyclePlayerC"\n\tworld_two.player = second_player\n\tworld_two.add_child(second_player)\n\tawait get_tree().process_frame\n\tvar second_position := Vector3(6.0, 3.0, 44.0)\n\tsecond_player.global_position = second_position\n\tworld_two.remove_child(second_player)\n\tawait get_tree().process_frame\n\t_check(world_two.player == null and SaveManager.get_position().is_equal_approx(second_position), "repeated world cycle remains single-shot and captures the latest position")\n\tsecond_player.queue_free()\n\tworld_two.queue_free()\n\tawait get_tree().process_frame\n\n\tGameManager.current_state = previous_state\n\tprint("World lifecycle guard complete: %d passed, %d failed" % [passed, failed])\n\tget_tree().quit(0 if failed == 0 else 4)\n'''

