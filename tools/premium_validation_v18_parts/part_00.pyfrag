WORLD_RESOURCE_REPEAT_TEST_RELATIVE = 'tests/world_resource_repeat_test.gd'
WORLD_RESOURCE_REPEAT_TEST_CONTENT = '''extends Node

const RESOURCE_PATHS := [
	["NPC scene", "res://scenes/npc_pedestrian.tscn"],
	["NPC manager script", "res://scripts/npc_manager.gd"],
	["world script", "res://scripts/world.gd"],
	["world scene", "res://scenes/world.tscn"],
]

var passed := 0
var failed := 0


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	call_deferred("_run")


func _check(condition: bool, label: String) -> void:
	if condition:
		passed += 1
		print("[PASS] " + label)
	else:
		failed += 1
		push_error("[FAIL] " + label)


func _run() -> void:
	_check(FileAccess.file_exists("res://scenes/npc_pedestrian.tscn"), "NPC scene remains present before repeated loads")
	_check(FileAccess.get_file_as_bytes("res://scenes/npc_pedestrian.tscn").size() > 0, "NPC scene remains nonempty before repeated loads")

	for cycle in range(3):
		for item in RESOURCE_PATHS:
			var resource = ResourceLoader.load(item[1], "", ResourceLoader.CACHE_MODE_IGNORE)
			_check(resource != null, "%s loads in delayed cycle %d" % [item[0], cycle + 1])
		var npc_scene = ResourceLoader.load("res://scenes/npc_pedestrian.tscn", "", ResourceLoader.CACHE_MODE_IGNORE) as PackedScene
		var npc_instance = npc_scene.instantiate() if npc_scene else null
		_check(npc_instance is CharacterBody3D, "NPC scene instantiates in delayed cycle %d" % [cycle + 1])
		if npc_instance:
			npc_instance.free()
		var world_scene = ResourceLoader.load("res://scenes/world.tscn", "", ResourceLoader.CACHE_MODE_IGNORE) as PackedScene
		var world_instance = world_scene.instantiate() if world_scene else null
		_check(world_instance is Node3D, "world scene instantiates in delayed cycle %d" % [cycle + 1])
		if world_instance:
			world_instance.free()

	_check(FileAccess.file_exists("res://scenes/npc_pedestrian.tscn"), "NPC scene remains present after repeated cleanup")
	print("World resource repeat complete: %d passed, %d failed" % [passed, failed])
	get_tree().quit(0 if failed == 0 else 5)
'''

