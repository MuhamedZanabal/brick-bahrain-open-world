            contexts.append([
                line.rstrip('\r\n')
                for line in lines[max(0, access_index - 4):min(len(lines), access_index + 3)]
            ])
        else:
            guard_indices.append(guard_index)
    if contexts:
        raise RuntimeError(
            f'player global-position access has no enclosing player guard: contexts={contexts}'
        )
    unique_guards = sorted(set(guard_indices))
    if len(unique_guards) != 1:
        guard_lines = [lines[index].rstrip('\r\n') for index in unique_guards]
        access_lines = [lines[index].strip() for index in access_indices]
        raise RuntimeError(
            'player global-position accesses do not share one guard: '
            f'guards={guard_lines}, accesses={access_lines}'
        )
    guard_index = unique_guards[0]
    raw_guard = lines[guard_index].rstrip('\r\n')
    match = SAVE_CONDITION_PATTERN.fullmatch(raw_guard)
    if match is None:
        raise RuntimeError(f'invalid player guard syntax: {raw_guard}')
    condition = match.group('condition').strip()
    if SAVE_TREE_GUARD_PATTERN.search(condition):
        return text, 'already_satisfied'
    newline = (
        '\r\n' if lines[guard_index].endswith('\r\n')
        else '\n' if lines[guard_index].endswith('\n')
        else ''
    )
    lines[guard_index] = (
        f'{match.group("indent")}if {condition} and player.is_inside_tree():' + newline
    )
    return ''.join(lines), 'applied'


def correct_world_title(text: str) -> tuple[str, str]:
    matches = list(WORLD_TITLE_PATTERN.finditer(text))
    if len(matches) != 1:
        candidates = [
            line.strip() for line in text.splitlines()
            if 'title.text' in line or 'BRICK BAHRAIN' in line or 'Bahrain Brick' in line
        ]
        raise RuntimeError(
            'world title correction mismatch: '
            f'match_count={len(matches)}, candidates={candidates}'
        )
    match = matches[0]
    if match.group('title') == 'Bahrain Brick':
        return text, 'already_satisfied'
    replacement = f'{match.group("indent")}title.text = "Bahrain Brick"'
    return WORLD_TITLE_PATTERN.sub(lambda _match: replacement, text, count=1), 'applied'


def correct_world_lifecycle(text: str) -> tuple[str, list[str], str]:
    protected_before = verify_protected_world_exit(text)

    state_count = text.count(WORLD_LIFECYCLE_STATE_BLOCK)
    ready_anchor_count = text.count(WORLD_STATE_ANCHOR)
    if state_count == 0 and ready_anchor_count == 1:
        text = text.replace(
            WORLD_STATE_ANCHOR,
            WORLD_LIFECYCLE_STATE_BLOCK + WORLD_STATE_ANCHOR,
            1,
        )
        state_state = 'applied'
    elif state_count == 1 and ready_anchor_count == 1:
        state_state = 'already_satisfied'
    else:
        raise RuntimeError(
            'world lifecycle state mismatch: '
            f'block_count={state_count}, ready_anchor_count={ready_anchor_count}'
        )

    ready_old_count = text.count(WORLD_READY_ANCHOR)
    ready_new_count = text.count(WORLD_READY_PATCHED)
    if ready_old_count == 1 and ready_new_count == 0:
        text = text.replace(WORLD_READY_ANCHOR, WORLD_READY_PATCHED, 1)
        ready_state = 'applied'
    elif ready_old_count == 0 and ready_new_count == 1:
        ready_state = 'already_satisfied'
    else:
        raise RuntimeError(
            'world lifecycle ready-hook mismatch: '
            f'old_count={ready_old_count}, new_count={ready_new_count}'
        )

    process_old_count = text.count(WORLD_PROCESS_ANCHOR)
    process_new_count = text.count(WORLD_PROCESS_PATCHED)
    if process_old_count == 1 and process_new_count == 0:
        text = text.replace(WORLD_PROCESS_ANCHOR, WORLD_PROCESS_PATCHED, 1)
        process_state = 'applied'
    elif process_old_count == 0 and process_new_count == 1:
        process_state = 'already_satisfied'
    else:
        raise RuntimeError(
            'world lifecycle process-hook mismatch: '
            f'old_count={process_old_count}, new_count={process_new_count}'
        )

    lifecycle_count = text.count(WORLD_LIFECYCLE_BLOCK)
    exit_anchor = 'func _exit_tree() -> void:\n'
    if lifecycle_count == 0 and text.count(exit_anchor) == 1:
        text = text.replace(exit_anchor, WORLD_LIFECYCLE_BLOCK + exit_anchor, 1)
        lifecycle_state = 'applied'
    elif lifecycle_count == 1:
        lifecycle_state = 'already_satisfied'
    else:
        raise RuntimeError(
            'world lifecycle coordinator mismatch: '
            f'block_count={lifecycle_count}, exit_anchor_count={text.count(exit_anchor)}'
