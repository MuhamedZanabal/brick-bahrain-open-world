NPC_UNSAFE_PATTERN = re.compile(
    r'(?m)^(?P<indent>[ \t]*)(?P<variable>_animation_player|_anim_player)\s*=\s*'
    r'_model\.get_meta\(\s*&?["\']anim_player["\']'
    r'(?:\s*,\s*null)?\s*\)(?:\s+as\s+AnimationPlayer)?\s*$'
)
NPC_SAFE_PATTERN = re.compile(
    r'(?m)^[ \t]*(?:_animation_player|_anim_player)\s*=.*_model\.get_meta\(.*anim_player.*\)'
    r'.*_model\.has_meta\(\s*&?["\']anim_player["\']\s*\).*else\s+null\s*$'
)
NPC_SAFE_TEMPLATE = (
    '{indent}{variable} = (_model.get_meta("anim_player") as AnimationPlayer) '
    'if _model.has_meta("anim_player") else null'
)
SAVE_CONDITION_PATTERN = re.compile(r'^(?P<indent>[ \t]*)if\s+(?P<condition>.+):\s*$')
SAVE_TREE_GUARD_PATTERN = re.compile(r'\bplayer\.is_inside_tree\s*\(\s*\)')
PLAYER_GLOBAL_POSITION_PATTERN = re.compile(r'\bplayer\.global_position\b')

WORLD_TITLE_PATTERN = re.compile(
    r'(?m)^(?P<indent>[ \t]*)title\.text\s*=\s*"(?P<title>BRICK BAHRAIN|Bahrain Brick)"\s*$'
)
WORLD_STATE_ANCHOR = 'func _ready() -> void:\n'
WORLD_LIFECYCLE_STATE_BLOCK = '''var _last_valid_player_position := Vector3.ZERO\nvar _has_last_valid_player_position := false\n\n\n'''
WORLD_READY_ANCHOR = '\t_show_loading_screen()\n\tcall_deferred("_load_step_environment")'
WORLD_READY_PATCHED = '\t_show_loading_screen()\n\t_install_world_lifecycle_guard()\n\tcall_deferred("_load_step_environment")'
WORLD_PROCESS_ANCHOR = 'func _process(delta: float) -> void:\n\tif not _world_ready:'
WORLD_PROCESS_PATCHED = 'func _process(delta: float) -> void:\n\t_cache_active_player_position()\n\tif not _world_ready:'
WORLD_LIFECYCLE_BLOCK = '''func _install_world_lifecycle_guard() -> void:\n\tif not child_exiting_tree.is_connected(_on_world_child_exiting_tree):\n\t\tchild_exiting_tree.connect(_on_world_child_exiting_tree)\n\n\nfunc _cache_active_player_position() -> void:\n\tif player == null or not player is Node3D:\n\t\treturn\n\tvar active_player := player as Node3D\n\tif not active_player.is_inside_tree():\n\t\treturn\n\t_last_valid_player_position = active_player.global_position\n\t_has_last_valid_player_position = true\n\n\nfunc _on_world_child_exiting_tree(node: Node) -> void:\n\tif node != player or not node is Node3D:\n\t\treturn\n\tvar active_player := node as Node3D\n\tif active_player.is_inside_tree():\n\t\t_last_valid_player_position = active_player.global_position\n\t\t_has_last_valid_player_position = true\n\tif _has_last_valid_player_position:\n\t\tSaveManager.set_position(_last_valid_player_position)\n\tplayer = null\n\n\n'''
