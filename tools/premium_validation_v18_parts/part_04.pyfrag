
    world_path = root / 'scripts/world.gd'
    if not world_path.is_file():
        raise RuntimeError('correction target missing: scripts/world.gd')
    before = world_path.read_bytes()
    text = before.decode('utf-8')
    protected_before = verify_protected_world_exit(text)
    text, title_state = correct_world_title(text)
    text, lifecycle_states, protected_after = correct_world_lifecycle(text)
    world_path.write_text(text, encoding='utf-8')
    after = world_path.read_bytes()
    results.append({
        'path': 'scripts/world.gd',
        'before_sha256': sha(before),
        'after_sha256': sha(after),
        'states': [title_state, *lifecycle_states],
        'reasons': [
            'remove obsolete reversed product title from the in-world loading overlay',
            'connect the unprotected parent child-exit lifecycle coordinator',
            'capture the active player position and clear the stale reference before protected teardown',
        ],
        'protected_function': 'scripts/world.gd::_exit_tree',
        'protected_function_sha256_before': protected_before,
        'protected_function_sha256_after': protected_after,
        'protected_function_unchanged': protected_before == protected_after == PROTECTED_WORLD_EXIT_SHA256,
    })

    generated_runtime_resources = [ensure_npc_scene(root)]
    generated_validation_resources = [
        ensure_exact_resource(
            root,
            WORLD_LIFECYCLE_FIXTURE_RELATIVE,
            WORLD_LIFECYCLE_FIXTURE_CONTENT,
            'minimal inherited world fixture that executes the real unprotected lifecycle coordinator',
        ),
        ensure_exact_resource(
            root,
            WORLD_LIFECYCLE_TEST_RELATIVE,
            WORLD_LIFECYCLE_TEST_CONTENT,
            'exercise player exit, non-player exit, replacement, idempotence and repeated world cycles',
        ),
        ensure_exact_resource(
            root,
            WORLD_LIFECYCLE_SCENE_RELATIVE,
            WORLD_LIFECYCLE_SCENE_CONTENT,
            'project-context Godot scene for protected-compliant lifecycle validation',
        ),
        ensure_exact_resource(
            root,
            WORLD_RESOURCE_REPEAT_TEST_RELATIVE,
            WORLD_RESOURCE_REPEAT_TEST_CONTENT,
            'repeat delayed NPC/world resource loading and instantiation after presentation validation',
        ),
        ensure_exact_resource(
            root,
            WORLD_RESOURCE_REPEAT_SCENE_RELATIVE,
            WORLD_RESOURCE_REPEAT_SCENE_CONTENT,
            'project-context scene for repeated delayed NPC/world resource validation',
        ),
    ]

    export = root / 'export_presets.cfg'
    text = export.read_text(encoding='utf-8')
    text, n1 = re.subn(r'(?m)^version/code=.*$', 'version/code=1404', text)
    text, n2 = re.subn(
        r'(?m)^version/name=.*$',
        'version/name="1.4.0.4-premium-visual-qa"',
        text,
    )
    if (n1, n2) != (1, 1):
        raise RuntimeError(f'export version replacement failure: {(n1, n2)}')
    export.write_text(text, encoding='utf-8')

    stale: list[dict] = []
    scanned: list[str] = []
    for path in runtime_text_paths(root):
        relative = path.relative_to(root).as_posix()
        scanned.append(relative)
        try:
            body = path.read_text(encoding='utf-8')
        except (UnicodeDecodeError, OSError):
            continue
        for token in STALE_TITLES:
            if token in body:
                stale.append({'path': relative, 'token': token})
    if stale:
        raise RuntimeError(f'obsolete runtime title occurrences remain: {stale}')

    final_world = world_path.read_text(encoding='utf-8')
    final_protected_hash = verify_protected_world_exit(final_world)
    return {
        'conclusion': 'pass',
        'corrections': results,
        'generated_runtime_resources': generated_runtime_resources,
        'generated_validation_resources': generated_validation_resources,
        'runtime_text_files_scanned': sorted(set(scanned)),
        'obsolete_runtime_title_occurrences': stale,
        'protected_world_exit_expected_sha256': PROTECTED_WORLD_EXIT_SHA256,
        'protected_world_exit_actual_sha256': final_protected_hash,
        'protected_world_exit_unchanged': final_protected_hash == PROTECTED_WORLD_EXIT_SHA256,
        'diagnostic_sources': collect_diagnostic_sources(root),
    }


