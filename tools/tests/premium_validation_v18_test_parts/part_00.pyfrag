            + '\tGameManager.current_state = GameManager.GameState.LOADING\n'
            + '\t_show_loading_screen()\n'
            + '\tcall_deferred("_load_step_environment")\n\n\n'
            + 'func _exit_tree() -> void:\n'
            + '\tif GameManager.current_state == GameManager.GameState.IN_WORLD:\n'
            + '\t\tif player and player is Node3D:\n'
            + '\t\t\tSaveManager.set_position((player as Node3D).global_position)\n'
            + '\t\tSaveManager.save_game("world exit")\n'
            + '\tRadioSystem.stop_radio()\n'
            + '\tChatManager.set_world_active(false)\n'
