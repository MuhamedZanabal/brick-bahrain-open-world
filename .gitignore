# Godot 4 generated cache. Keep explicit source-side import settings trackable; ignore only generated cache trees.
.godot/
**/.godot/

# Godot 3/legacy generated import cache directory (not *.import sidecars).
.import/
**/.import/

# Android generated build output (regenerated by Gradle/Godot export, not source).
android/build/
android/.gradle/

# Godot editor mono cache (if any).
.mono/
data_*/

# Phase 2 generated/transient working output. Durable reports/evidence belong in their named directories.
build/
asset_lab/reports/tmp/
asset_lab/evidence/tmp/
asset_lab/exports/tmp/

# Blender/editor transient recovery files.
*.blend1
*.blend2
*.blend@

# Python/tool caches.
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS files.
.DS_Store
Thumbs.db
