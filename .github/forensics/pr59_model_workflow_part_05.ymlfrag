      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with: {ref: '${{ github.sha }}', path: tooling, fetch-depth: 1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: '${{ env.INPUT_NAME }}', path: build/input, repository: MuhamedZanabal/brick-bahrain-open-world, run-id: '${{ env.INPUT_RUN }}', github-token: '${{ github.token }}'}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: '${{ env.SEED_NAME }}', path: build/seed, repository: MuhamedZanabal/brick-bahrain-open-world, run-id: '${{ env.SEED_RUN }}', github-token: '${{ github.token }}'}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-preseed-authority-${{ github.run_id }}', path: build/preseed}
      - name: Independent preseeded import D1
        shell: bash
        run: |
          godot=build/input/input/godot/Godot_v4.3-stable_linux.x86_64; chmod +x "$godot"
          python3 tooling/.github/forensics/pr59_model_binary_forensics.py seeded-run --source-zip build/input/input/MANAMA_SOUQ_COMPOSITE_SOURCE.zip --godot "$godot" --seed-zip build/seed/GODOT_IMPORT_UID_SIDECARS_V1.zip --seed-manifest build/seed/GODOT_IMPORT_UID_SIDECARS_V1.json --preseed-cache build/preseed/uid_cache.bin --output build/preseed-d1 --work-root /tmp/pr59-preseed-d1 --label PRESEED_D1
      - uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808
        with: {name: 'pr59-model-preseed-d1-${{ github.run_id }}', path: 'build/preseed-d1/SEEDED_DIAGNOSTIC_RESULT.json', if-no-files-found: error, compression-level: 9, retention-days: 30}

  preseed_d2:
    needs: preseed_authority
    runs-on: ubuntu-24.04
    timeout-minutes: 110
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with: {ref: '${{ github.sha }}', path: tooling, fetch-depth: 1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: '${{ env.INPUT_NAME }}', path: build/input, repository: MuhamedZanabal/brick-bahrain-open-world, run-id: '${{ env.INPUT_RUN }}', github-token: '${{ github.token }}'}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: '${{ env.SEED_NAME }}', path: build/seed, repository: MuhamedZanabal/brick-bahrain-open-world, run-id: '${{ env.SEED_RUN }}', github-token: '${{ github.token }}'}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-preseed-authority-${{ github.run_id }}', path: build/preseed}
      - name: Independent preseeded import D2
        shell: bash
        run: |
          godot=build/input/input/godot/Godot_v4.3-stable_linux.x86_64; chmod +x "$godot"
          python3 tooling/.github/forensics/pr59_model_binary_forensics.py seeded-run --source-zip build/input/input/MANAMA_SOUQ_COMPOSITE_SOURCE.zip --godot "$godot" --seed-zip build/seed/GODOT_IMPORT_UID_SIDECARS_V1.zip --seed-manifest build/seed/GODOT_IMPORT_UID_SIDECARS_V1.json --preseed-cache build/preseed/uid_cache.bin --output build/preseed-d2 --work-root /tmp/pr59-preseed-d2 --label PRESEED_D2
      - uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808
        with: {name: 'pr59-model-preseed-d2-${{ github.run_id }}', path: 'build/preseed-d2/SEEDED_DIAGNOSTIC_RESULT.json', if-no-files-found: error, compression-level: 9, retention-days: 30}

  preseed_compare:
    needs: [preseed_d1, preseed_d2]
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with: {ref: '${{ github.sha }}', path: tooling, fetch-depth: 1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-preseed-d1-${{ github.run_id }}', path: build/preseed-d1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-preseed-d2-${{ github.run_id }}', path: build/preseed-d2}
      - run: python3 tooling/.github/forensics/pr59_model_binary_forensics.py preseed-compare --d1 build/preseed-d1 --d2 build/preseed-d2 --output build/PRESEED_COMPARISON.json
      - uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808
        with: {name: 'pr59-model-preseed-comparison-${{ github.run_id }}', path: build/PRESEED_COMPARISON.json, if-no-files-found: error, compression-level: 9, retention-days: 30}

  minimal_controls:
    needs: retained_compare
    runs-on: ubuntu-24.04
    timeout-minutes: 300
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with: {ref: '${{ github.sha }}', path: tooling, fetch-depth: 1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: '${{ env.INPUT_NAME }}', path: build/input, repository: MuhamedZanabal/brick-bahrain-open-world, run-id: '${{ env.INPUT_RUN }}', github-token: '${{ github.token }}'}
