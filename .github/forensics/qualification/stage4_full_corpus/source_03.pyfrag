    return {'timestamp_ns':time.time_ns(),'hostname':socket.gethostname(),'platform':platform.platform(),'python':sys.version,'cpu_count':os.cpu_count(),'cpu_affinity':sorted(os.sched_getaffinity(0)) if hasattr(os,'sched_getaffinity') else None,'runner_name':os.environ.get('RUNNER_NAME'),'runner_os':os.environ.get('RUNNER_OS'),'runner_arch':os.environ.get('RUNNER_ARCH'),'github_job':os.environ.get('GITHUB_JOB'),'github_run_id':os.environ.get('GITHUB_RUN_ID'),'project_root':str(project.resolve()),'locale':{k:os.environ.get(k) for k in ('LANG','LC_ALL','TZ')},'umask':oct(mask),'disk':cmd(['df','-B1',str(project.parent)]),'memory':Path('/proc/meminfo').read_text() if Path('/proc/meminfo').is_file() else '', 'lscpu':cmd(['lscpu'])}
def run_import_process(runtime:Path,project:Path,log:Path,timeout:int)->dict[str,Any]:
    xdg=project.parent/'xdg';shutil.rmtree(xdg,ignore_errors=True);(xdg/'config').mkdir(parents=True);(xdg/'cache').mkdir();(xdg/'data').mkdir()
    env=os.environ.copy();env.update({'LANG':'C.UTF-8','LC_ALL':'C.UTF-8','TZ':'UTC','XDG_CONFIG_HOME':str(xdg/'config'),'XDG_CACHE_HOME':str(xdg/'cache'),'XDG_DATA_HOME':str(xdg/'data'),'HOME':str(xdg)})
    command=[str(runtime),'--headless','--path',str(project),'--editor','--import','--quit','--verbose'];start_ns=time.time_ns();start=time.monotonic();log.parent.mkdir(parents=True,exist_ok=True)
    with log.open('wb') as f:
        proc=subprocess.Popen(command,stdout=f,stderr=subprocess.STDOUT,env=env,start_new_session=True);timed=False
        try:code=proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            timed=True
            try:os.killpg(proc.pid,signal.SIGTERM)
            except ProcessLookupError:pass
            try:code=proc.wait(timeout=30)
            except subprocess.TimeoutExpired:
                try:os.killpg(proc.pid,signal.SIGKILL)
                except ProcessLookupError:pass
                code=proc.wait(timeout=30)
    return {'command':command,'start_timestamp_ns':start_ns,'end_timestamp_ns':time.time_ns(),'duration_seconds':time.monotonic()-start,'exit_code':code,'timed_out':timed,'watchdog_result':'TIMEOUT' if timed else 'COMPLETED','log_sha256':sha256_file(log),'log_bytes':log.stat().st_size}
def deterministic_zip(items:list[tuple[Path,str]],output:Path)->None:
    output.parent.mkdir(parents=True,exist_ok=True)
    with zipfile.ZipFile(output,'w',zipfile.ZIP_DEFLATED,compresslevel=9) as z:
        for src,arc in sorted(items,key=lambda x:x[1].encode()):
            info=zipfile.ZipInfo(arc,(1980,1,1,0,0,0));info.compress_type=zipfile.ZIP_DEFLATED;info.external_attr=0o100644<<16;z.writestr(info,src.read_bytes())
def load_corpus(path:Path)->dict[str,Any]:
    v=load_json(path)
    if v.get('result')!='PASS' or len(v.get('models',[]))!=TOTAL_MODELS:raise AuthorityError('invalid corpus authority')
    return v

def build_sidecar_authority(authority_root:Path,corpus_path:Path,engine_root:Path,work:Path,out:Path,timeout:int)->dict[str,Any]:
    project=work/'authority-project';source_report=verify_source_authority(authority_root,project,True);corpus=load_corpus(corpus_path);models=corpus['models'];shutil.rmtree(project/'.godot',ignore_errors=True)
    for row in models:
        try:(project/row['expected_sidecar_path']).unlink()
        except FileNotFoundError:pass
    engine=verify_engine(engine_root,work/'engine');out.mkdir(parents=True,exist_ok=True);log=out/'GODOT_4_4_1_FULL_SIDECAR_AUTHORITY.log';run=run_import_process(Path(engine['runtime_path']),project,log,timeout);mapped=[];rejected=[];items=[]
    for row in models:
        rel=row['logical_source_path'];side_rel=row['expected_sidecar_path'];side=project/side_rel
        try:
            if not side.is_file():raise AuthorityError('sidecar missing')
            data=side.read_bytes();parsed=parse_import_sidecar(data)
            verify_import_sidecar_contract(row,parsed)
            companion=project/md5_companion_path(parsed['imported_relative_path'])
            if not companion.is_file():raise AuthorityError('companion missing')
            md5=parse_md5_companion(companion.read_bytes())
            if md5['source_md5']!=row['source_md5']:raise AuthorityError('source MD5 mismatch')
            copied=out/'sidecars'/side_rel;copied.parent.mkdir(parents=True,exist_ok=True);copied.write_bytes(data);items.append((copied,side_rel))
            mapped.append({'global_index':row['global_index'],'logical_source_path':rel,'source_type':row['source_type'],'matrix_member':row['matrix_member'],'sidecar_path':side_rel,'sidecar_byte_size':len(data),'sidecar_sha256':sha256_bytes(data),'source_md5':row['source_md5'],'destination_md5':md5['dest_md5'],'uid':parsed['uid'],'importer':parsed['importer'],'resource_type':parsed['type'],'imported_relative_path':parsed['imported_relative_path'],'dest_files':parsed['dest_files'],'parameters':parsed['parameters'],'parameters_sha256':parsed['parameters_sha256']})
        except Exception as e:rejected.append({'global_index':row['global_index'],'logical_source_path':rel,'error':repr(e)})
    result='PASS' if run['exit_code']==0 and not run['timed_out'] and len(mapped)==TOTAL_MODELS and not rejected else 'FAIL'
    summary={'schema_version':1,'result':result,'engine_authority':engine,'source_authority':source_report,'expected_model_sidecars':TOTAL_MODELS,'verified_model_sidecars':len(mapped),'rejected_sidecars':len(rejected),'missing_sidecars':sum('missing' in x['error'] for x in rejected),'source_mismatches':sum('source' in x['error'].lower() for x in rejected),'importer_mismatches':sum('importer mismatch' in x['error'].lower() for x in rejected),'type_mismatches':sum('type mismatch' in x['error'].lower() for x in rejected),'imported_extension_mismatches':sum('extension mismatch' in x['error'].lower() for x in rejected),'unsafe_target_paths':sum('unsafe' in x['error'].lower() for x in rejected),'import_duration_seconds':run['duration_seconds'],'import_exit_code':run['exit_code'],'timed_out':run['timed_out'],'watchdog_result':run['watchdog_result'],'log_sha256':run['log_sha256'],'rejected':rejected,'no_generated_godot_reuse':True,'no_stage5':True}
    write_json(out/'GODOT_4_4_1_FULL_SIDECAR_AUTHORITY.json',summary);write_json(out/'GODOT_4_4_1_MODEL_SIDECAR_MAP.json',{'schema_version':1,'models':mapped});deterministic_zip(items,out/'GODOT_4_4_1_FULL_SIDECAR_AUTHORITY.zip');write_json(out/'SIDECAR_ARTIFACT_INVENTORY.json',build_inventory(out/'sidecars'));return summary
def materialize_sidecars(project:Path,root:Path,models:list[dict[str,Any]])->dict[str,Any]:
    maps=list(root.rglob('GODOT_4_4_1_MODEL_SIDECAR_MAP.json'));zips=list(root.rglob('GODOT_4_4_1_FULL_SIDECAR_AUTHORITY.zip'));summaries=list(root.rglob('GODOT_4_4_1_FULL_SIDECAR_AUTHORITY.json'))
    if len(maps)!=1 or len(zips)!=1 or len(summaries)!=1:raise AuthorityError('sidecar authority files missing')
    summary=load_json(summaries[0]);mapping=load_json(maps[0])
    if summary.get('result')!='PASS' or summary.get('verified_model_sidecars')!=TOTAL_MODELS or len(mapping.get('models',[]))!=TOTAL_MODELS:raise AuthorityError('sidecar authority not PASS')
    for row in models:
        try:(project/row['expected_sidecar_path']).unlink()
        except FileNotFoundError:pass
    safe_extract_zip(zips[0],project);by={x['logical_source_path']:x for x in mapping['models']};verified=[]
    for row in models:
        auth=by.get(row['logical_source_path']);path=project/row['expected_sidecar_path']
        if not auth or not path.is_file() or sha256_file(path)!=auth['sidecar_sha256']:raise AuthorityError(f'sidecar mismatch:{row["logical_source_path"]}')
        parsed=parse_import_sidecar(path.read_bytes());verify_import_sidecar_contract(row,parsed)
        if parsed['imported_relative_path']!=auth['imported_relative_path']:raise AuthorityError('sidecar fields mismatch')
        verified.append(auth)
