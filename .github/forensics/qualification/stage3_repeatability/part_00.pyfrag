UID_RE = re.compile(rb"uid://[A-Za-z0-9_./:@+-]+")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")


def read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha512_file(path: Path) -> str:
    digest = hashlib.sha512()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def md5_file(path: Path) -> str:
    digest = hashlib.md5()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def find_unique(root: Path, filename: str) -> Path:
    matches = sorted(root.rglob(filename))
    if len(matches) != 1:
        raise RuntimeError(f"expected exactly one {filename} below {root}, found {len(matches)}")
    return matches[0]


def strip_internal(value: Any) -> Any:
    if isinstance(value, dict):
        return {k: strip_internal(v) for k, v in value.items() if not k.startswith("_")}
    if isinstance(value, list):
        return [strip_internal(v) for v in value]
    return value


def parse_key(text: str, key: str) -> str | None:
    match = re.search(rf"(?m)^{re.escape(key)}=\"([^\"]*)\"\s*$", text)
    return match.group(1) if match else None


def section_text(text: str, section: str) -> str:
    match = re.search(rf"(?ms)^\[{re.escape(section)}\]\s*\n(.*?)(?=^\[[^\]]+\]\s*$|\Z)", text)
    return match.group(1).strip() if match else ""


def parse_sidecar(path: Path, source_md5: str) -> dict[str, Any]:
    data = path.read_bytes()
    text = data.rstrip(b"\x00").decode("utf-8", errors="strict")
    importer = parse_key(text, "importer")
    resource_type = parse_key(text, "type")
    imported = parse_key(text, "path")
    source_file = parse_key(text, "source_file")
    params = section_text(text, "params")
    if imported and imported.startswith("res://"):
        imported = imported[len("res://") :]
    return {
        "path": path.as_posix(),
        "size": len(data),
        "sha256": sha256_bytes(data),
        "importer": importer,
        "type": resource_type,
        "source_file": source_file,
        "source_md5": source_md5,
        "imported_relative_path": imported,
        "params_sha256": sha256_bytes(params.encode("utf-8")),
        "params_text": params,
        "uid": parse_key(text, "uid"),
        "importer_version": re.search(r"(?m)^importer_version=([^\r\n]+)$", text).group(1).strip()
        if re.search(r"(?m)^importer_version=([^\r\n]+)$", text)
        else None,
    }


def verify_file(path: Path, expected: dict[str, Any], label: str) -> dict[str, Any]:
    if not path.is_file():
        raise RuntimeError(f"missing {label}: {path}")
    actual = {
        "path": path.as_posix(),
        "bytes": path.stat().st_size,
        "sha256": sha256_file(path),
        "md5": md5_file(path),
    }
    for key in ("bytes", "sha256", "md5"):
        if key in expected and expected[key] is not None and actual[key] != expected[key]:
            raise RuntimeError(f"{label} {key} mismatch: expected {expected[key]} actual {actual[key]}")
    return actual


def verify_stage2_authority(
    *,
    version: str,
    selection_id: str,
    corpus_root: Path,
    stage2_resource_root: Path,
    expected_artifact: dict[str, Any],
) -> dict[str, Any]:
    report_path = find_unique(stage2_resource_root, "RESOURCE_QUALIFICATION.json")
    report = read_json(report_path)
    if report.get("candidate_resource_result") != "PASS":
        raise RuntimeError("Stage 2 resource was not a PASS authority")
    if report.get("engine_version") != version:
        raise RuntimeError("Stage 2 engine identity mismatch")
    if report.get("resource_selection_id") != selection_id:
        raise RuntimeError("Stage 2 selection identity mismatch")

    corpus = read_json(find_unique(corpus_root, "CORPUS_AUTHORITY.json"))
    resources = [row for row in corpus.get("resources", []) if row.get("selection_id") == selection_id]
    if len(resources) != 1:
        raise RuntimeError(f"corpus selection missing or duplicate: {selection_id}")
    resource = resources[0]
    if report.get("logical_source_path") != resource["logical_source"]:
        raise RuntimeError("Stage 2 logical path does not match corpus authority")
    if report.get("source_type") != resource["source_type"]:
        raise RuntimeError("Stage 2 source type does not match corpus authority")

    files_root = find_unique(corpus_root, "CORPUS_AUTHORITY.json").parent / "files"
    source_path = files_root / resource["logical_source"]
    source_actual = verify_file(
        source_path,
        {
            "bytes": resource["source_bytes"],
            "sha256": resource["source_sha256"],
            "md5": resource["source_md5"],
        },
        "source resource",
    )
    for key, report_key in (
        ("bytes", "source_byte_size"),
        ("sha256", "source_sha256"),
        ("md5", "source_md5"),
    ):
        if report.get(report_key) != source_actual[key]:
            raise RuntimeError(f"Stage 2 report {report_key} mismatch")

    dependency_actual = []
    for dependency in resource.get("dependencies", []):
        path = files_root / dependency["path"]
        dependency_actual.append(verify_file(path, dependency, f"dependency {dependency['path']}"))
    expected_deps = sorted(
        (row["path"], row["bytes"], row["sha256"], row["md5"]) for row in resource.get("dependencies", [])
    )
    report_deps = sorted(
        (row["path"], row["bytes"], row["sha256"], row["md5"])
        for row in report.get("dependency_paths_and_hashes", [])
    )
    if expected_deps != report_deps:
        raise RuntimeError("Stage 2 dependency authority mismatch")

    sidecar_root = report_path.parent / "sidecar_authority"
    if not sidecar_root.is_dir():
        raise RuntimeError("Stage 2 sidecar authority directory missing")
    actual_manifest = []
    for path in sorted(sidecar_root.rglob("*.import"), key=lambda p: p.relative_to(sidecar_root).as_posix()):
        actual_manifest.append(
            {
                "path": path.relative_to(sidecar_root).as_posix(),
                "size": path.stat().st_size,
                "sha256": sha256_file(path),
            }
        )
    expected_manifest = sorted(report.get("sidecar_authority_manifest", []), key=lambda row: row["path"])
    if actual_manifest != expected_manifest:
        raise RuntimeError("Stage 2 sidecar authority manifest mismatch")
    if len(actual_manifest) != report.get("sidecar_authority_count"):
        raise RuntimeError("Stage 2 sidecar authority count mismatch")

    main_rel = report["sidecar_path"]
    main_path = sidecar_root / main_rel
    if not main_path.is_file():
        raise RuntimeError("Stage 2 main sidecar authority missing")
    if sha256_file(main_path) != report["sidecar_sha256"] or main_path.stat().st_size != report["sidecar_size"]:
        raise RuntimeError("Stage 2 main sidecar authority mismatch")
    main = parse_sidecar(main_path, source_actual["md5"])
    if main["source_file"] != "res://" + resource["logical_source"]:
        raise RuntimeError("Stage 2 sidecar source_file mismatch")
    if main["imported_relative_path"] != report.get("D1_imported_path"):
        raise RuntimeError("Stage 2 sidecar destination differs from D1")
    if main["imported_relative_path"] != report.get("D2_imported_path"):
        raise RuntimeError("Stage 2 sidecar destination differs from D2")
    if not main["importer"] or not main["type"] or not main["params_text"]:
        raise RuntimeError("Stage 2 sidecar importer/type/params incomplete")

    artifact_metadata_path = stage2_resource_root / "ARTIFACT_METADATA.json"
    if artifact_metadata_path.is_file():
        actual_artifact = read_json(artifact_metadata_path)
        for key in ("id", "digest", "name"):
            if actual_artifact.get(key) != expected_artifact.get(key):
                raise RuntimeError(f"Stage 2 artifact metadata {key} mismatch")
    else:
        actual_artifact = dict(expected_artifact)

    return {
        "schema_version": 1,
        "verified": True,
        "verified_at": utc_now(),
        "stage2_run_id": STAGE2_RUN_ID,
        "stage2_workflow_sha": STAGE2_WORKFLOW_SHA,
        "stage2_artifact": actual_artifact,
        "engine_version": version,
        "resource_selection_id": selection_id,
        "resource": resource,
        "source_actual": source_actual,
        "dependencies_actual": dependency_actual,
        "sidecar_root": str(sidecar_root),
        "sidecar_count": len(actual_manifest,
