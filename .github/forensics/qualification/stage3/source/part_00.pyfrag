def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")


def canonical_json_bytes(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")
    temporary.replace(path)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def sha512_file(path: Path) -> str:
    digest = hashlib.sha512()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def md5_file(path: Path) -> str:
    digest = hashlib.md5(usedforsecurity=False)
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def safe_relative(value: str) -> Path:
    candidate = Path(value)
    if candidate.is_absolute() or ".." in candidate.parts:
        raise ValueError(f"unsafe relative path: {value!r}")
    return candidate


def without_res_prefix(value: str) -> str:
    return value[6:] if value.startswith("res://") else value


def authority_matrix() -> list[dict[str, Any]]:
    return [
        {
            "version": engine,
            "resource": item["selection_id"],
            "source_type": item["source_type"],
            "timeout_seconds": item["timeout_seconds"],
        }
        for engine in ENGINES
        for item in RESOURCES
    ]


def c_side_matrix() -> list[dict[str, Any]]:
    return [dict(item, side=side) for item in authority_matrix() for side in ("C1", "C2")]


def _extract_quoted(text: str, key: str) -> str | None:
    match = re.search(rf"(?m)^\s*{re.escape(key)}\s*=\s*\"([^\"]*)\"\s*$", text)
    return match.group(1) if match else None


def parse_import_sidecar(text: str) -> dict[str, Any]:
    importer = _extract_quoted(text, "importer")
    resource_type = _extract_quoted(text, "type")
    uid = _extract_quoted(text, "uid")
    path = _extract_quoted(text, "path")
    source_file = _extract_quoted(text, "source_file")
    dest_match = re.search(r"(?m)^\s*dest_files\s*=\s*(\[[^\n]*\])\s*$", text)
    dest_values: list[str] = []
    if dest_match:
        parsed = ast.literal_eval(dest_match.group(1))
        if not isinstance(parsed, list) or not all(isinstance(item, str) for item in parsed):
            raise ValueError("invalid dest_files sidecar authority")
        dest_values = [without_res_prefix(item) for item in parsed]
    required = {"importer": importer, "type": resource_type, "path": path, "source_file": source_file}
    missing = [key for key, value in required.items() if not value]
    if missing:
        raise ValueError(f"sidecar missing required fields: {missing}")
    section_match = re.search(r"(?ms)^\[params\]\s*\n(.*?)(?=^\[[^\]]+\]\s*$|\Z)", text)
    parameter_text = section_match.group(1) if section_match else ""
    return {
        "importer": importer,
        "type": resource_type,
        "uid": uid,
        "source_file": without_res_prefix(source_file or ""),
        "imported_relative_path": without_res_prefix(path or ""),
        "dest_files": dest_values,
        "parameters_sha256": sha256_bytes(parameter_text.encode("utf-8")),
    }


def _verify_file(path: Path, *, expected_sha256: str, expected_bytes: int, expected_md5: str | None = None) -> dict[str, Any]:
    if not path.is_file():
        raise FileNotFoundError(path)
