      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: '${{ env.SEED_NAME }}', path: build/seed, repository: MuhamedZanabal/brick-bahrain-open-world, run-id: '${{ env.SEED_RUN }}', github-token: '${{ github.token }}'}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-retained-${{ github.run_id }}', path: build/retained}
      - name: Run isolated two-import controls for GLB GLTF FBX and OBJ
        shell: bash
        run: |
          set +e
          godot=build/input/input/godot/Godot_v4.3-stable_linux.x86_64; chmod +x "$godot"
          python3 tooling/.github/forensics/pr59_model_binary_forensics.py minimal --source-zip build/input/input/MANAMA_SOUQ_COMPOSITE_SOURCE.zip --seed-zip build/seed/GODOT_IMPORT_UID_SIDECARS_V1.zip --godot "$godot" --selection build/retained/REPRESENTATIVE_SELECTION.json --output build/minimal --work-root /tmp/pr59-minimal-models
          code=$?; mkdir -p build/minimal; printf '%s\n' "$code" > build/minimal/EXIT_CODE.txt; exit 0
      - name: Upload minimal-project evidence even on failure
        if: always()
        uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808
        with: {name: 'pr59-model-minimal-controls-${{ github.run_id }}', path: build/minimal, if-no-files-found: error, compression-level: 9, retention-days: 30}
      - run: test "$(cat build/minimal/EXIT_CODE.txt)" = 0

  source_audit:
    needs: record_locator
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with: {ref: '${{ github.sha }}', path: tooling, fetch-depth: 1}
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          repository: godotengine/godot
          ref: ${{ env.GODOT_COMMIT }}
          path: godot-source
          fetch-depth: 1
      - name: Audit exact Godot importer and binary-saver source
        shell: bash
        run: |
          set +e
          test "$(git -C godot-source rev-parse HEAD)" = "$GODOT_COMMIT"
          mkdir -p build/audit
          python3 tooling/.github/forensics/pr59_godot_source_audit.py --source-root godot-source --output build/audit
          code=$?; printf '%s\n' "$code" > build/audit/EXIT_CODE.txt; exit 0
      - name: Upload source trace even on failure
        if: always()
        uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808
        with: {name: 'pr59-model-source-audit-${{ github.run_id }}', path: build/audit, if-no-files-found: error, compression-level: 9, retention-days: 30}
      - run: test "$(cat build/audit/EXIT_CODE.txt)" = 0

  aggregate:
    if: always()
    needs: [retained_compare, diagnostic_d1, diagnostic_d2, compare_pairs, preseed_compare, minimal_controls, source_audit]
    runs-on: ubuntu-24.04
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with: {ref: '${{ github.sha }}', path: tooling, fetch-depth: 1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-retained-${{ github.run_id }}', path: build/retained}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-diagnostic-d1-${{ github.run_id }}', path: build/d1}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-diagnostic-d2-${{ github.run_id }}', path: build/d2}
      - uses: actions/download-artifact@d3f86a106a0bac45b974a628896c90dbdf5c8093
        with: {name: 'pr59-model-pair-comparison-${{ github.run_id }}', path: build/pairs}
