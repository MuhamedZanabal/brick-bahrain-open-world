REQUIRED_MATRIX_COUNT = 436
CURRENT_REMAP_RE = re.compile(r'(?m)^path="res://([^"\r\n]+)"\s*$')
ROBUST_REMAP_RE = re.compile(r'(?m)^\s*path(?:\.[A-Za-z0-9_-]+)?\s*=\s*"res://([^"\r\n]+)"\s*$')
COMPILED_ALIASES = {".scn": ".tscn", ".res": ".tres", ".gdc": ".gd"}
REVERSE_COMPILED = {v: k for k, v in COMPILED_ALIASES.items()}


def sha256_file(path: Path, chunk: int = 1024 * 1024) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(chunk), b""):
            h.update(block)
    return h.hexdigest()


def write_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n", encoding="utf-8")


def read_json(path: Path) -> Any:
    return json.loads(path.read_text(encoding="utf-8"))


def norm(path: str) -> str:
    return str(path).replace("res://", "").replace("\\", "/").lstrip("/")


def unsafe(path: str) -> bool:
    return path.startswith("/") or bool(re.match(r"^[A-Za-z]:[/\\]", path)) or "\\" in path or ".." in PurePosixPath(path.replace("\\", "/")).parts or "\x00" in path


def case_collisions(paths: Iterable[str]) -> list[list[str]]:
    groups: dict[str, set[str]] = collections.defaultdict(set)
    for p in paths:
        groups[p.casefold()].add(p)
    return [sorted(v) for v in groups.values() if len(v) > 1]


def find_all(root: Path, basename: str) -> list[Path]:
    return sorted((p for p in root.rglob(basename) if p.is_file()), key=lambda p: (len(p.parts), p.as_posix()))


def find_one(root: Path, basename: str, required: bool = True) -> Path | None:
    values = find_all(root, basename)
    if not values:
        if required:
            raise FileNotFoundError(f"{basename} not found beneath {root}")
        return None
    return values[0]


def rel(path: Path, root: Path) -> str:
    return path.relative_to(root).as_posix()


def verify_evidence_inventory(root: Path) -> dict[str, Any]:
    inv_path = find_one(root, "EVIDENCE_INVENTORY.json")
    assert inv_path is not None
    inv = read_json(inv_path)
    base = inv_path.parent
    records = inv.get("files", []) if isinstance(inv, dict) else []
    failures: list[dict[str, Any]] = []
    verified: list[dict[str, Any]] = []
    for record in records:
        if not isinstance(record, dict):
            failures.append({"reason": "non-object inventory record"})
            continue
        p = base / str(record.get("path", ""))
        if not p.is_file():
            failures.append({"path": record.get("path"), "reason": "missing"})
            continue
