{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "device": {
      "properties": {
        "android_version": {
          "type": [
            "string",
            "integer"
          ]
        },
        "gpu": {
          "type": [
            "string",
            "integer"
          ]
        },
        "model": {
          "type": [
            "string",
            "integer"
          ]
        },
        "ram_mb": {
          "type": [
            "string",
            "integer"
          ]
        },
        "screen_resolution": {
          "type": [
            "string",
            "integer"
          ]
        },
        "soc": {
          "type": [
            "string",
            "integer"
          ]
        }
      },
      "required": [
        "model",
        "soc",
        "gpu",
        "ram_mb",
        "android_version",
        "screen_resolution"
      ],
      "type": "object"
    },
    "renderer_results": {
      "properties": {
        "gl_compatibility": {
          "required": [
            "renderer",
            "quality_preset",
            "apk_sha256",
            "cold_start",
            "scene_readiness",
            "five_minute_traversal",
            "peak_memory",
            "thermal_state",
            "pause_resume",
            "fatal_anr_native_crash_scan"
          ],
          "type": "object"
        },
        "mobile_vulkan": {
          "required": [
            "renderer",
            "quality_preset",
            "apk_sha256",
            "cold_start",
            "scene_readiness",
            "five_minute_traversal",
            "peak_memory",
            "thermal_state",
            "pause_resume",
            "fatal_anr_native_crash_scan"
          ],
          "type": "object"
        }
      },
      "required": [
        "gl_compatibility",
        "mobile_vulkan"
      ],
      "type": "object"
    },
    "tests_performed": {
      "const": false,
      "description": "Template remains false until a named device test is actually executed."
    }
  },
  "required": [
    "device",
    "renderer_results",
    "tests_performed"
  ],
  "title": "Bahrain Brick paired renderer physical-device result",
  "type": "object"
}
